generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Grade {
  id        String      @id @default(cuid())
  name      String      @unique
  sortOrder Int         @default(0)
  classes   SchoolClass[]
  students  Student[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model SchoolClass {
  id        String    @id @default(cuid())
  name      String
  gradeId   String
  grade     Grade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, gradeId])
}

model Student {
  id           String       @id @default(cuid())
  fullName     String
  anonymous    Boolean      @default(false)
  profileUrl   String?
  profilePublicId String?
  gradeId      String
  schoolClassId String?
  grade        Grade        @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  schoolClass  SchoolClass? @relation(fields: [schoolClassId], references: [id], onDelete: SetNull)
  artworks     Artwork[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([fullName])
  @@index([gradeId, schoolClassId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  coverUrl    String?
  coverPublicId String?
  sortOrder   Int       @default(0)
  artworks    Artwork[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  coverUrl    String?
  coverPublicId String?
  startsAt    DateTime?
  endsAt      DateTime?
  artworks    Artwork[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Artwork {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  description     String?
  materials       String[]          @default([])
  createdOn       DateTime?
  status          PublicationStatus @default(DRAFT)
  featured        Boolean           @default(false)
  videoUrl        String?
  videoPublicId   String?
  studentId       String
  categoryId      String
  projectId       String?
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  images          ArtworkImage[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([studentId])
  @@index([projectId])
  @@index([featured, status])
}

model ArtworkImage {
  id        String   @id @default(cuid())
  url       String
  publicId  String   @unique
  alt       String?
  sortOrder Int      @default(0)
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([artworkId, sortOrder])
}

model GalleryEvent {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  coverUrl    String?
  coverPublicId String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WebsiteSettings {
  id                  String   @id @default("main")
  platformName        String   @default("بصمة فن")
  subtitle            String   @default("الابتكارية ٢")
  slogan              String   @default("كل طالب فنان.. وكل إبداع له بصمة.")
  secondarySlogan     String   @default("من أنامل صغيرة تنطلق إبداعات كبيرة.. هنا نرسم أحلامنا ونترك بصمتنا.")
  description         String   @default("معرض الإبداع الفني الرقمي")
  teacherName         String   @default("الأستاذ غيلان الخزامي")
  teacherTitle        String   @default("أستاذ التربية الفنية")
  teacherPhotoUrl     String?
  teacherPhotoPublicId String?
  academicSupervisor  String   @default("الأستاذ رفيق عباس")
  principal           String   @default("الأستاذ محمد العتيبي")
  schoolLogoUrl       String?
  schoolLogoPublicId  String?
  organizationLogoUrl String?
  organizationLogoPublicId String?
  updatedAt           DateTime @updatedAt
}
